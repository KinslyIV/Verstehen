{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Verstehen",
	"version": "0.2.0",
	"identifier": "local.verstehen.app",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "Verstehen",
				"width": 1280,
				"height": 800,
				"resizable": true,
				"fullscreen": false,
				"label": "main",
				"visible": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' asset: data: blob: 'unsafe-inline' https:; font-src 'self' 'unsafe-inline' https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* 'unsafe-inline' https:"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": ["binaries/verstehen-sidecar"]
	},
	"plugins": {
		"shell": {
			"open": "^(https://auth\\.openai\\.com/.*|https://code\\.claude\\.com/docs/en/setup)$"
		}
	}
}
